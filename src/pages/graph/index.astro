---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_LANG, SITE_TITLE } from '../../consts';
import { buildKnowledgeGraph } from '../../lib/tags';

const graph = await buildKnowledgeGraph();
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead
			title={`知识图谱 · ${SITE_TITLE}`}
			description="类似 Obsidian Graph / Local graph：文章与标签的力导向星状图谱"
		/>
	</head>
	<body>
		<Header />
		<main class="graph-page">
			<section class="graph-toolbar site-shell">
				<div class="graph-copy">
					<p class="m-0 text-sm text-[var(--muted)]">知识图谱</p>
					<h1 class="mt-1 mb-1 text-xl font-bold text-[var(--ink)] sm:text-3xl">Graph / Local graph</h1>
					<p class="m-0 text-sm text-[var(--muted)]">
						布局稳定后会停住。滚轮 / 按钮缩放查看；点选进入星状 Local；双击节点打开文章。
					</p>
				</div>
				<div class="graph-controls">
					<button type="button" id="mode-global" class="ctl is-active">全局 Graph</button>
					<button type="button" id="mode-local" class="ctl">星状 Local</button>
					<button type="button" id="btn-zoom-out" class="ctl" title="缩小">−</button>
					<button type="button" id="btn-zoom-in" class="ctl" title="放大">+</button>
					<button type="button" id="btn-fit" class="ctl">适应</button>
					<button type="button" id="btn-reset" class="ctl">复位</button>
					<a class="ctl" href="/tags/">标签列表</a>
				</div>
				<p id="graph-status" class="graph-status m-0 text-xs text-[var(--muted)]"></p>
			</section>
			<div class="graph-stage">
				<canvas id="graph-canvas" aria-label="知识图谱画布"></canvas>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script is:inline define:vars={{ graph }}>
	(function () {
		const canvas = document.getElementById('graph-canvas');
		const status = document.getElementById('graph-status');
		const btnGlobal = document.getElementById('mode-global');
		const btnLocal = document.getElementById('mode-local');
		const btnReset = document.getElementById('btn-reset');
		const btnZoomIn = document.getElementById('btn-zoom-in');
		const btnZoomOut = document.getElementById('btn-zoom-out');
		const btnFit = document.getElementById('btn-fit');
		if (!canvas) return;

		const MIN_K = 0.12;
		const MAX_K = 14;

		const rawNodes = graph.nodes.map((n) => ({ ...n }));
		const rawLinks = graph.links.map((l) => ({ ...l }));
		const byId = Object.fromEntries(rawNodes.map((n) => [n.id, n]));
		const focusFromUrl = new URLSearchParams(location.search).get('focus') || '';

		let mode = 'global';
		let focusId = focusFromUrl && byId[focusFromUrl] ? focusFromUrl : null;
		let nodes = [];
		let links = [];
		let transform = { x: 0, y: 0, k: 1 };
		let dragging = null;
		let last = null;
		let width = 0;
		let height = 0;
		let raf = 0;
		let alpha = 0;
		let running = false;

		const css = getComputedStyle(document.documentElement);
		const colorInk = () => css.getPropertyValue('--ink').trim() || '#111';
		const colorMuted = () => css.getPropertyValue('--muted').trim() || '#777';
		const colorAccent = () => css.getPropertyValue('--accent').trim() || '#0f766e';
		const colorLine = () => css.getPropertyValue('--line').trim() || '#ddd';
		const colorBg = () => css.getPropertyValue('--bg-elevated').trim() || '#fff';

		function neighborIds(id) {
			const set = new Set([id]);
			for (const l of rawLinks) {
				if (l.source === id) set.add(l.target);
				if (l.target === id) set.add(l.source);
			}
			return set;
		}

		function rebuild() {
			let keep;
			if (mode === 'local' && focusId) {
				keep = neighborIds(focusId);
			} else {
				keep = new Set(rawNodes.map((n) => n.id));
			}
			nodes = rawNodes
				.filter((n) => keep.has(n.id))
				.map((n) => {
					const prev = nodes.find((p) => p.id === n.id);
					return {
						...n,
						x: prev?.x,
						y: prev?.y,
						vx: prev?.vx || 0,
						vy: prev?.vy || 0,
					};
				});
			const alive = new Set(nodes.map((n) => n.id));
			links = rawLinks
				.filter((l) => alive.has(l.source) && alive.has(l.target))
				.map((l) => ({
					source: nodes.find((n) => n.id === l.source),
					target: nodes.find((n) => n.id === l.target),
				}));

			const cx = width / 2;
			const cy = height / 2;
			nodes.forEach((n, i) => {
				if (n.x == null || n.y == null) {
					const a = (i / Math.max(nodes.length, 1)) * Math.PI * 2;
					const r = 40 + (i % 7) * 18;
					n.x = cx + Math.cos(a) * r;
					n.y = cy + Math.sin(a) * r;
				}
			});

			if (mode === 'local' && focusId) {
				const center = nodes.find((n) => n.id === focusId);
				const others = nodes.filter((n) => n.id !== focusId);
				if (center) {
					center.x = cx;
					center.y = cy;
					center.fx = cx;
					center.fy = cy;
					center.vx = 0;
					center.vy = 0;
				}
				others.forEach((n, i) => {
					const a = (i / Math.max(others.length, 1)) * Math.PI * 2 - Math.PI / 2;
					const r = Math.min(width, height) * 0.28;
					n.x = cx + Math.cos(a) * r;
					n.y = cy + Math.sin(a) * r;
					n.fx = n.x;
					n.fy = n.y;
					n.vx = 0;
					n.vy = 0;
				});
			} else {
				nodes.forEach((n) => {
					n.fx = null;
					n.fy = null;
					n.vx = 0;
					n.vy = 0;
				});
			}

			const base = mode === 'local' && focusId
				? `Local graph · 中心：${byId[focusId]?.label || focusId} · ${nodes.length} 节点`
				: `Graph · ${nodes.length} 节点 · ${links.length} 边`;
			status.dataset.base = base;
			status.textContent = `${base} · 缩放 ${transform.k.toFixed(2)}×`;

			// Local 用固定星状，不再持续模拟；Global 冷却后停下
			if (mode === 'local') {
				stopSim();
				draw();
				requestAnimationFrame(fitView);
			} else {
				reheat(1);
			}
		}

		function tick() {
			const n = nodes.length;
			if (!n || alpha <= 0.001) return;

			const energy = alpha;
			// repulsion
			for (let i = 0; i < n; i++) {
				for (let j = i + 1; j < n; j++) {
					const a = nodes[i];
					const b = nodes[j];
					let dx = a.x - b.x;
					let dy = a.y - b.y;
					let dist = Math.hypot(dx, dy) || 0.01;
					const force = (2200 * energy) / (dist * dist);
					dx = (dx / dist) * force;
					dy = (dy / dist) * force;
					if (a.fx == null) {
						a.vx += dx;
						a.vy += dy;
					}
					if (b.fx == null) {
						b.vx -= dx;
						b.vy -= dy;
					}
				}
			}

			// springs
			const ideal = 110;
			for (const l of links) {
				const a = l.source;
				const b = l.target;
				let dx = b.x - a.x;
				let dy = b.y - a.y;
				const dist = Math.hypot(dx, dy) || 0.01;
				const f = ((dist - ideal) / dist) * 0.035 * energy;
				dx *= f;
				dy *= f;
				if (a.fx == null) {
					a.vx += dx;
					a.vy += dy;
				}
				if (b.fx == null) {
					b.vx -= dx;
					b.vy -= dy;
				}
			}

			// center gravity
			const cx = width / 2;
			const cy = height / 2;
			for (const node of nodes) {
				if (node.fx != null) {
					node.x = node.fx;
					node.y = node.fy;
					node.vx = 0;
					node.vy = 0;
					continue;
				}
				node.vx += (cx - node.x) * 0.003 * energy;
				node.vy += (cy - node.y) * 0.003 * energy;
				node.vx *= 0.82;
				node.vy *= 0.82;
				node.x += node.vx;
				node.y += node.vy;
			}

			alpha *= 0.92;
		}

		function draw() {
			const ctx = canvas.getContext('2d');
			const dpr = window.devicePixelRatio || 1;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, width, height);
			ctx.save();
			ctx.translate(transform.x, transform.y);
			ctx.scale(transform.k, transform.k);

			ctx.lineWidth = 1 / transform.k;
			ctx.strokeStyle = colorLine();
			for (const l of links) {
				ctx.beginPath();
				ctx.moveTo(l.source.x, l.source.y);
				ctx.lineTo(l.target.x, l.target.y);
				ctx.stroke();
			}

			for (const node of nodes) {
				const isTag = node.kind === 'tag';
				const isFocus = node.id === focusId;
				const r = (isTag ? 8 : 5.5) * (isFocus ? 1.35 : 1);
				ctx.beginPath();
				ctx.arc(node.x, node.y, r, 0, Math.PI * 2);
				ctx.fillStyle = isTag ? colorAccent() : colorBg();
				ctx.fill();
				ctx.strokeStyle = isTag ? colorAccent() : colorInk();
				ctx.lineWidth = (isFocus ? 2.2 : 1.2) / transform.k;
				ctx.stroke();

				ctx.fillStyle = colorInk();
				ctx.font = `${(isTag ? 11 : 10) / transform.k}px sans-serif`;
				ctx.textAlign = 'center';
				ctx.textBaseline = 'top';
				const label = node.label.length > 16 ? node.label.slice(0, 15) + '…' : node.label;
				ctx.fillText(label, node.x, node.y + r + 3 / transform.k);
			}
			ctx.restore();
		}

		function stopSim() {
			running = false;
			alpha = 0;
			if (raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			}
		}

		function reheat(amount) {
			if (mode === 'local' && !dragging) {
				draw();
				return;
			}
			alpha = Math.min(1, Math.max(alpha, amount || 0.7));
			if (!running) {
				running = true;
				raf = requestAnimationFrame(loop);
			}
		}

		function loop() {
			if (!running) return;
			tick();
			draw();
			if (alpha > 0.002 || dragging) {
				raf = requestAnimationFrame(loop);
			} else {
				running = false;
				raf = 0;
				// 彻底刹住残余速度，避免肉眼微抖
				nodes.forEach((n) => {
					n.vx = 0;
					n.vy = 0;
				});
				draw();
			}
		}

		function resize() {
			const stage = canvas.parentElement;
			width = stage.clientWidth;
			height = Math.max(520, Math.floor(window.innerHeight * 0.72));
			const dpr = window.devicePixelRatio || 1;
			canvas.width = Math.floor(width * dpr);
			canvas.height = Math.floor(height * dpr);
			canvas.style.width = width + 'px';
			canvas.style.height = height + 'px';
			rebuild();
		}

		function zoomAt(sx, sy, factor) {
			const before = screenToWorld(sx, sy);
			transform.k = Math.min(MAX_K, Math.max(MIN_K, transform.k * factor));
			const after = screenToWorld(sx, sy);
			transform.x += (after.x - before.x) * transform.k;
			transform.y += (after.y - before.y) * transform.k;
			draw();
			updateStatusZoom();
		}

		function updateStatusZoom() {
			if (!status) return;
			const base = status.dataset.base || status.textContent || '';
			status.dataset.base = base.replace(/\s·\s缩放.+$/, '');
			status.textContent = `${status.dataset.base} · 缩放 ${transform.k.toFixed(2)}×`;
		}

		function fitView() {
			if (!nodes.length) return;
			let minX = Infinity;
			let minY = Infinity;
			let maxX = -Infinity;
			let maxY = -Infinity;
			for (const n of nodes) {
				minX = Math.min(minX, n.x);
				minY = Math.min(minY, n.y);
				maxX = Math.max(maxX, n.x);
				maxY = Math.max(maxY, n.y);
			}
			const pad = 56;
			const bw = Math.max(maxX - minX, 40);
			const bh = Math.max(maxY - minY, 40);
			const k = Math.min((width - pad * 2) / bw, (height - pad * 2) / bh, MAX_K);
			transform.k = Math.max(MIN_K, Math.min(MAX_K, k * 0.92));
			transform.x = width / 2 - ((minX + maxX) / 2) * transform.k;
			transform.y = height / 2 - ((minY + maxY) / 2) * transform.k;
			draw();
			updateStatusZoom();
		}

		function screenToWorld(sx, sy) {
			return {
				x: (sx - transform.x) / transform.k,
				y: (sy - transform.y) / transform.k,
			};
		}

		function hit(sx, sy) {
			const p = screenToWorld(sx, sy);
			let best = null;
			let bestD = 14 / transform.k;
			for (const node of nodes) {
				const d = Math.hypot(node.x - p.x, node.y - p.y);
				if (d < bestD) {
					best = node;
					bestD = d;
				}
			}
			return best;
		}

		function setMode(next) {
			mode = next;
			btnGlobal.classList.toggle('is-active', mode === 'global');
			btnLocal.classList.toggle('is-active', mode === 'local');
			if (mode === 'local' && !focusId && nodes[0]) focusId = nodes[0].id;
			rebuild();
		}

		canvas.addEventListener('pointerdown', (e) => {
			const rect = canvas.getBoundingClientRect();
			const sx = e.clientX - rect.left;
			const sy = e.clientY - rect.top;
			const node = hit(sx, sy);
			if (node) {
				dragging = node;
				node.fx = node.x;
				node.fy = node.y;
				canvas.setPointerCapture(e.pointerId);
				reheat(0.4);
			} else {
				last = { x: e.clientX, y: e.clientY };
			}
		});

		canvas.addEventListener('pointermove', (e) => {
			const rect = canvas.getBoundingClientRect();
			if (dragging) {
				const p = screenToWorld(e.clientX - rect.left, e.clientY - rect.top);
				dragging.fx = p.x;
				dragging.fy = p.y;
				dragging.x = p.x;
				dragging.y = p.y;
				draw();
			} else if (last) {
				transform.x += e.clientX - last.x;
				transform.y += e.clientY - last.y;
				last = { x: e.clientX, y: e.clientY };
				draw();
			}
		});

		function endDrag() {
			if (dragging) {
				if (mode === 'global') {
					dragging.fx = null;
					dragging.fy = null;
					reheat(0.35);
				} else {
					// Local 保持固定位置
					dragging.fx = dragging.x;
					dragging.fy = dragging.y;
					draw();
				}
			}
			dragging = null;
			last = null;
		}
		canvas.addEventListener('pointerup', endDrag);
		canvas.addEventListener('pointercancel', endDrag);

		canvas.addEventListener('click', (e) => {
			const rect = canvas.getBoundingClientRect();
			const node = hit(e.clientX - rect.left, e.clientY - rect.top);
			if (!node) return;
			focusId = node.id;
			if (mode !== 'local') setMode('local');
			else rebuild();
		});

		canvas.addEventListener('dblclick', (e) => {
			const rect = canvas.getBoundingClientRect();
			const node = hit(e.clientX - rect.left, e.clientY - rect.top);
			if (node?.href) window.location.href = node.href;
		});

		canvas.addEventListener(
			'wheel',
			(e) => {
				e.preventDefault();
				const rect = canvas.getBoundingClientRect();
				const mx = e.clientX - rect.left;
				const my = e.clientY - rect.top;
				const intensity = Math.min(Math.abs(e.deltaY) / 100, 2.5);
				const step = 1 + 0.18 * intensity;
				zoomAt(mx, my, e.deltaY < 0 ? step : 1 / step);
			},
			{ passive: false },
		);

		btnGlobal.addEventListener('click', () => setMode('global'));
		btnLocal.addEventListener('click', () => setMode('local'));
		btnZoomIn?.addEventListener('click', () => zoomAt(width / 2, height / 2, 1.35));
		btnZoomOut?.addEventListener('click', () => zoomAt(width / 2, height / 2, 1 / 1.35));
		btnFit?.addEventListener('click', () => fitView());
		btnReset.addEventListener('click', () => {
			transform = { x: 0, y: 0, k: 1 };
			focusId = focusFromUrl && byId[focusFromUrl] ? focusFromUrl : null;
			setMode(focusId ? 'local' : 'global');
		});

		window.addEventListener('resize', resize);
		window.addEventListener('blog:appearance', draw);
		resize();
		if (focusId) setMode('local');
		else {
			rebuild();
			// 全局布局冷却后再适应视野
			const waitFit = setInterval(() => {
				if (!running) {
					clearInterval(waitFit);
					fitView();
				}
			}, 120);
			setTimeout(() => clearInterval(waitFit), 4000);
		}
	})();
</script>

<style>
	.graph-page {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-bottom: 1rem;
	}
	.graph-toolbar {
		padding-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.graph-controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.ctl {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.2rem;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		color: var(--ink);
		font-size: 0.82rem;
		text-decoration: none;
		cursor: pointer;
	}
	.ctl.is-active {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent);
	}
	.graph-stage {
		margin: 0 0.75rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--bg-elevated);
		box-shadow: var(--shadow);
		overflow: hidden;
	}
	@media (min-width: 640px) {
		.graph-stage {
			margin: 0 auto;
			width: min(100% - 2rem, 72rem);
		}
	}
	#graph-canvas {
		display: block;
		width: 100%;
		touch-action: none;
		cursor: grab;
	}
</style>
