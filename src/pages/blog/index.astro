---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="site-shell py-6 sm:py-12">
			<header class="panel mb-6 px-4 py-5 sm:mb-8 sm:px-6 sm:py-6">
				<p class="hud-label m-0">Archive / Index</p>
				<h1 class="mt-2 mb-2 text-2xl font-bold text-[var(--ink)] sm:text-4xl">全部文章</h1>
				<p class="m-0 text-sm text-[var(--muted)] sm:text-base">Markdown → Astro 静态编译 → Pages 分发</p>
			</header>
			<ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
				{
					posts.map((post) => (
						<li class="card">
							<a href={`/blog/${post.id}/`} class="block no-underline">
								{post.data.heroImage && (
									<Image
										class="h-40 w-full object-cover"
										width={720}
										height={360}
										src={post.data.heroImage}
										alt=""
									/>
								)}
								<div class="p-4 sm:p-5">
									<p class="mono m-0 text-xs text-[var(--accent)]">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="mt-2 mb-2 text-lg font-bold text-[var(--ink)] sm:text-xl">{post.data.title}</h2>
									<p class="m-0 text-sm text-[var(--muted)]">{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
