---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if ((stored || (prefersDark ? 'dark' : 'light')) === 'dark') {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body>
		<Header />
		<main class="site-shell py-10 sm:py-14">
			<section class="relative overflow-hidden rounded-[28px] border border-[var(--line)] bg-[var(--bg-elevated)] px-6 py-10 shadow-[var(--shadow)] sm:px-10 sm:py-14">
				<div
					class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-[var(--accent-soft)] blur-2xl"
					aria-hidden="true"
				></div>
				<p class="relative m-0 text-sm font-semibold tracking-[0.18em] text-[var(--accent)] uppercase">
					Personal Blog
				</p>
				<h1 class="relative mt-3 mb-3 text-4xl font-bold tracking-tight text-[var(--ink)] sm:text-5xl">
					{SITE_TITLE}
				</h1>
				<p class="relative m-0 max-w-2xl text-lg text-[var(--muted)]">{SITE_DESCRIPTION}</p>
				<div class="relative mt-7 flex flex-wrap gap-3">
					<a
						href="/blog"
						class="inline-flex items-center rounded-full bg-[var(--accent)] px-5 py-2.5 text-sm font-semibold text-white no-underline shadow-sm transition hover:opacity-90"
					>
						浏览文章
					</a>
					<a
						href="/about"
						class="inline-flex items-center rounded-full border border-[var(--line)] bg-[var(--bg)] px-5 py-2.5 text-sm font-semibold text-[var(--ink)] no-underline"
					>
						关于我
					</a>
				</div>
			</section>

			<section class="mt-12">
				<div class="mb-5 flex items-end justify-between gap-3">
					<h2 class="m-0 text-2xl font-bold text-[var(--ink)]">最近更新</h2>
					<a href="/blog" class="text-sm font-semibold no-underline">全部文章 →</a>
				</div>
				<ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 md:grid-cols-2">
					{
						posts.map((post, index) => (
							<li class:list={['card overflow-hidden', index === 0 && 'md:col-span-2']}>
								<a href={`/blog/${post.id}/`} class="block no-underline">
									{post.data.heroImage && (
										<Image
											class="h-48 w-full object-cover md:h-56"
											width={index === 0 ? 1200 : 720}
											height={index === 0 ? 480 : 360}
											src={post.data.heroImage}
											alt=""
										/>
									)}
									<div class="p-5">
										<p class="m-0 text-sm text-[var(--muted)]">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="mt-2 mb-2 text-xl font-bold text-[var(--ink)]">{post.data.title}</h3>
										<p class="m-0 text-[var(--muted)]">{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
