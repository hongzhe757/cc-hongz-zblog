---
import BaseHead from '../components/BaseHead.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';
import { getAllPosts } from '../lib/tags';

const posts = await getAllPosts();

const grouped = posts.reduce<{ year: string; items: typeof posts }[]>((acc, post) => {
	const year = String(post.data.pubDate.getFullYear());
	const last = acc[acc.length - 1];
	if (last && last.year === year) last.items.push(post);
	else acc.push({ year, items: [post] });
	return acc;
}, []);
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead
			title={`文章时间轴 · ${SITE_TITLE}`}
			description="按发布时间排列的博客文章时间轴"
		/>
	</head>
	<body>
		<Header />
		<main class="site-shell py-6 sm:py-12">
			<section class="max-w-2xl">
				<p class="m-0 text-sm text-[var(--muted)]">时间轴</p>
				<h1 class="mt-2 mb-2 text-[1.6rem] font-bold tracking-tight text-[var(--ink)] sm:text-4xl">
					文章时间轴
				</h1>
				<p class="m-0 text-sm leading-relaxed text-[var(--muted)] sm:text-base">
					共 {posts.length} 篇，按发布时间从新到旧。日期来自 Obsidian / Git 首次提交时间。
				</p>
				<div class="mt-4 flex flex-wrap gap-2">
					<a class="btn-cyber btn-cyber-ghost" href="/blog/">按分类浏览</a>
					<a class="btn-cyber btn-cyber-ghost" href="/graph/">知识图谱</a>
					<a class="btn-cyber btn-cyber-ghost" href="/about/">项目时间轴</a>
				</div>
			</section>

			<section class="mt-10 max-w-2xl sm:mt-14">
				{
					grouped.length === 0 ? (
						<p class="text-[var(--muted)]">暂无文章。</p>
					) : (
						<ol class="timeline m-0 list-none p-0">
							{grouped.map((group, gi) => (
								<li class:list={['year-block', gi === grouped.length - 1 && 'is-last']}>
									<div class="year-head">
										<span class="year-label">{group.year}</span>
										<span class="year-count">{group.items.length} 篇</span>
										<span class="year-rule" aria-hidden="true" />
									</div>
									<div class="year-body">
										{group.items.map((post) => (
											<article class="entry">
												<div class="entry-meta">
													<span class="entry-period">
														<FormattedDate date={post.data.pubDate} />
													</span>
													<CategoryBadge category={post.data.category} />
												</div>
												<h2 class="entry-title">
													<a href={`/blog/${post.id}/`}>{post.data.title}</a>
												</h2>
												<p class="entry-body">{post.data.description}</p>
											</article>
										))}
									</div>
								</li>
							))}
						</ol>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.timeline {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	@media (min-width: 640px) {
		.timeline {
			gap: 2.15rem;
		}
	}

	.year-head {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.9rem;
	}

	.year-label {
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--accent);
		line-height: 1;
	}

	@media (min-width: 640px) {
		.year-label {
			font-size: 1.2rem;
		}
	}

	.year-count {
		flex-shrink: 0;
		font-size: 0.75rem;
		color: var(--muted);
	}

	.year-rule {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, var(--accent), transparent 92%);
		opacity: 0.45;
	}

	.year-body {
		display: flex;
		flex-direction: column;
		gap: 1.05rem;
		padding-left: 0.85rem;
		border-left: 2px solid color-mix(in srgb, var(--accent) 28%, var(--line));
	}

	@media (min-width: 640px) {
		.year-body {
			gap: 1.2rem;
			padding-left: 1.15rem;
		}
	}

	.entry {
		position: relative;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
	}

	.entry::before {
		content: '';
		position: absolute;
		top: 0.45rem;
		left: calc(-0.85rem - 5px);
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--bg-elevated);
		border: 2px solid var(--accent);
	}

	@media (min-width: 640px) {
		.entry::before {
			left: calc(-1.15rem - 5px);
		}
	}

	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.65rem;
		margin-bottom: 0.3rem;
	}

	.entry-period {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.entry-title {
		margin: 0 0 0.3rem;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.35;
	}

	@media (min-width: 640px) {
		.entry-title {
			font-size: 1.15rem;
		}
	}

	.entry-title a {
		color: var(--ink);
		text-decoration: none;
	}

	.entry-title a:hover {
		color: var(--accent);
	}

	.entry-body {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--muted);
	}
</style>
