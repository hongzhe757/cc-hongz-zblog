---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';

/** 按项目起始年份从早到晚 */
const timeline = [
	{
		year: '2013',
		period: '2013.02 — 2014.02',
		title: '游戏脚本 / 桌面工具',
		role: '开发',
		body: 'VB / VC++ 桌面工具与自动化脚本：图像识别、钩子、窗口绑定，早期独立工程实践。',
	},
	{
		year: '2014',
		period: '2014.06 — 2016.06',
		title: '三亚福音医院官网改造',
		role: '开发工程师',
		body: 'PHP / Java 双版本官网：需求分析、库表设计、第三方客服对接与运维。',
	},
	{
		year: '2017',
		period: '2017.04 — 2018.03',
		title: '医保智能审核 / 监控审核系统',
		role: 'JAVA 开发工程师 · 金仕达卫宁',
		body: '规则引擎违规分析，面向医生与社保中心；参保人 / 就诊 / 处方 / 结算等多维数据，落地超过 20 个地市。',
	},
	{
		year: '2018',
		period: '2018.04 — 2020.03',
		title: '银行消费贷款 / 银企直连',
		role: '高级工程师 · 中电金信',
		body: '汽车消贷、马消贷与烟草银企直连：对接核心 / ESB / 影像 / 签章；Blaze 规则引擎与风控；多地市回单报表。',
	},
	{
		year: '2020',
		period: '2020.04 — 2024.02',
		title: 'V2I 仿真测试平台',
		role: 'Web 端架构 / 主程 · 中电金信',
		body: '从 0 到 1：百度地图 2D 仿真、试点城市红绿灯、HOOK 推送车机 GPS；绿灯 / 闯红灯 / RSI 等 V2I 服务。',
	},
	{
		year: '2021',
		period: '2021.01 — 2024.02',
		title: 'V2X 仿真测试平台',
		role: 'Web 端架构 / 主程 · 中电金信',
		body: '虚幻引擎 3D 升级：C-V2X 场景与中间件、高精地图园区、国标 / 国外红绿灯、2017/2019 多标准；Jenkins / Sonar 联调。',
	},
	{
		year: '2024',
		period: '2024.04 — 2025.02',
		title: 'E 泊士智慧停车 / 道闸',
		role: 'Web 端架构 / 主程',
		body: '国央企停车场收费与道闸模块研发、规范建设与上线部署；停车充电一体化。',
	},
	{
		year: '2024',
		period: '2024.04 — 2025.02',
		title: '科研课题申报 / AI 落地',
		role: '申报与集成',
		body: '省厅级科研课题材料与审查；AI 相关项目集成落地。',
	},
	{
		year: '2025',
		period: '2025.06 — 2025.12',
		title: '实验室管理软件 LIMS',
		role: '全栈 · 上海赛印',
		body: '委托订单、样品管理、检测管理、报告管理等核心模块前后端交付。',
	},
	{
		year: '2025',
		period: '2025.12 — 2026.01',
		title: '信贷研发（个贷 / 网贷）',
		role: '全栈 · 南天信息',
		body: '个人信贷与网贷系统前后端研发。',
	},
] as const;

const grouped = timeline.reduce<
	{ year: string; items: (typeof timeline)[number][] }[]
>((acc, item) => {
	const last = acc[acc.length - 1];
	if (last && last.year === item.year) {
		last.items.push(item);
	} else {
		acc.push({ year: item.year, items: [item] });
	}
	return acc;
}, []);
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead
			title={`关于 · ${SITE_TITLE}`}
			description="秦鸿哲（hongz）项目时间轴：按起始年份排列"
		/>
	</head>
	<body>
		<Header />
		<main class="site-shell py-6 sm:py-12">
			<section class="max-w-2xl">
				<p class="m-0 text-sm text-[var(--muted)]">关于</p>
				<h1 class="mt-2 mb-2 text-[1.6rem] font-bold tracking-tight text-[var(--ink)] sm:text-4xl">
					秦鸿哲 <span class="text-[var(--muted)] font-normal">/ hongz</span>
				</h1>
				<p class="m-0 text-sm leading-relaxed text-[var(--ink)] sm:text-base">
					Java 全栈 / 架构，约 10 年。覆盖互联网金融、智能汽车（V2X/V2I）、医疗医保、停车充电、实验室信息化与科研申报。
				</p>
				<div class="mt-5 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:gap-3">
					<a class="btn-cyber btn-cyber-primary" href="mailto:hongzhe.qin@outlook.com">邮件联系</a>
					<a
						class="btn-cyber btn-cyber-ghost"
						href="https://github.com/hongzhe757"
						target="_blank"
						rel="noreferrer"
					>
						GitHub
					</a>
					<a class="btn-cyber btn-cyber-ghost" href="/blog">看文章</a>
				</div>
			</section>

			<section class="mt-12 max-w-2xl sm:mt-16">
				<div class="mb-7 flex items-end justify-between gap-3 border-b border-[var(--line)] pb-3">
					<h2 class="m-0 text-xl font-bold text-[var(--ink)] sm:text-2xl">项目时间轴</h2>
					<p class="m-0 shrink-0 text-xs text-[var(--muted)] sm:text-sm">按起始年 · 早 → 晚</p>
				</div>

				<ol class="timeline m-0 list-none p-0">
					{
						grouped.map((group, gi) => (
							<li class:list={['year-block', gi === grouped.length - 1 && 'is-last']}>
								<div class="year-rail" aria-hidden="true">
									<span class="year-label">{group.year}</span>
									<span class="year-dot" />
								</div>
								<div class="year-body">
									{group.items.map((item) => (
										<article class="entry">
											<div class="entry-meta">
												<span class="entry-period">{item.period}</span>
												<span class="entry-role">{item.role}</span>
											</div>
											<h3 class="entry-title">{item.title}</h3>
											<p class="entry-body">{item.body}</p>
										</article>
									))}
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="mt-12 max-w-2xl border-t border-[var(--line)] pt-6 sm:mt-16">
				<p class="m-0 text-sm text-[var(--muted)]">
					邮箱 <a href="mailto:hongzhe.qin@outlook.com">hongzhe.qin@outlook.com</a>
					· 本站 Astro + Pages · 评论 Giscus
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.timeline {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.year-block {
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr);
		gap: 0.85rem;
		align-items: start;
	}

	@media (min-width: 640px) {
		.year-block {
			grid-template-columns: 4.25rem minmax(0, 1fr);
			gap: 1.35rem;
		}
	}

	.year-rail {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 100%;
		padding-top: 0.15rem;
	}

	.year-rail::after {
		content: '';
		position: absolute;
		top: 1.85rem;
		bottom: -0.15rem;
		left: 50%;
		width: 1px;
		transform: translateX(-50%);
		background: var(--line);
	}

	.year-block.is-last .year-rail::after {
		display: none;
	}

	.year-label {
		position: relative;
		z-index: 1;
		font-variant-numeric: tabular-nums;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--accent);
		line-height: 1.2;
		background: var(--bg);
		padding: 0.1rem 0;
	}

	@media (min-width: 640px) {
		.year-label {
			font-size: 0.95rem;
		}
	}

	.year-dot {
		position: relative;
		z-index: 1;
		margin-top: 0.45rem;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
		flex-shrink: 0;
	}

	.year-body {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		padding-bottom: 1.75rem;
	}

	.year-block.is-last .year-body {
		padding-bottom: 0;
	}

	.entry {
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
	}

	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.7rem;
		margin-bottom: 0.35rem;
	}

	.entry-period {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.01em;
		color: var(--muted);
	}

	.entry-role {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		padding: 0.12rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		color: var(--ink);
		font-size: 0.7rem;
		line-height: 1.35;
	}

	.entry-title {
		margin: 0 0 0.35rem;
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--ink);
	}

	@media (min-width: 640px) {
		.entry-title {
			font-size: 1.15rem;
		}
	}

	.entry-body {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--muted);
	}
</style>
