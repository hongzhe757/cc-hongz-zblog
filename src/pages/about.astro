---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';

/** 时间轴：从早到晚 */
const timeline = [
	{
		time: '2012.09 — 2015.06',
		tag: '教育',
		title: '海南软件职业技术学院 · 软件技术 · 专科',
		body: '系统学习软件开发基础，开始接触工程实践与独立项目。',
	},
	{
		time: '2013.02 — 2014.02',
		tag: '起步',
		title: '脚本与工具开发',
		body: '用 VB / VC++ 做桌面工具与自动化脚本，熟悉 Windows 交互、图像识别与钩子技术，养成「能跑起来」的工程习惯。',
	},
	{
		time: '2014.06 — 2016.06',
		tag: '项目',
		title: '三亚福音医院官网改造',
		body: 'PHP / Java 双版本官网：需求分析、库表设计、第三方客服对接与运维支持。',
	},
	{
		time: '2015.09 — 2017.06',
		tag: '教育',
		title: '海南热带海洋学院 · 计算机科学与技术 · 本科',
		body: '专升本继续深造，补齐体系化计算机基础，为后续架构与带队打底。',
	},
	{
		time: '2017.04 — 2018.03',
		tag: '工作',
		title: '上海金仕达卫宁 · 开发工程师',
		body: '医保智能审核 / 监控审核：规则引擎违规分析，面向医生与社保中心；多维度数据（参保人、就诊、处方、结算等），落地超过 20 个地市。',
	},
	{
		time: '2018.04 — 2020.03',
		tag: '项目',
		title: '银行消费贷款 / 银企直连（中电金信前期）',
		body: '汽车消贷、马消贷与烟草银企直连：需求梳理、跨部门联调；对接核心 / ESB / 影像 / 签章；Blaze 规则引擎与风控；烟草多地市回单报表。',
	},
	{
		time: '2018.04 — 2025.03',
		tag: '工作',
		title: '中电金信 · 高级设计开发工程师 / 架构师',
		body: '长期主战场：从金融改造到智能汽车仿真，再到停车充电与科研申报。负责 Web 架构、主程交付、研发规范与 8–10 人团队任务拆分、跟踪与客户对接。',
	},
	{
		time: '2020.04 — 2024.02',
		tag: '项目',
		title: 'V2I 仿真测试平台 · Web 端架构 / 主程',
		body: '从 0 到 1：基于百度地图的 2D 仿真；试点城市红绿灯地图；HOOK 向车机推送 GPS；绿灯 / 闯红灯 / RSI 等 V2I 服务，降低车厂路测成本。',
	},
	{
		time: '2021.01 — 2024.02',
		tag: '项目',
		title: 'V2X 仿真测试平台 · Web 端架构 / 主程',
		body: '在 V2I 上升级虚幻引擎 3D 版：C-V2X 场景与中间件、高精地图园区、国标 / 国外红绿灯模拟、2017/2019 多标准兼容；Jenkins / Sonar 与全平台联调测试。',
	},
	{
		time: '2024.04 — 2025.02',
		tag: '项目',
		title: 'E 泊士智慧停车 / 道闸 + 科研申报',
		body: '国央企停车场收费与道闸模块、规范与上线；同期参与省厅级科研课题材料与 AI 相关集成落地。',
	},
	{
		time: '2025.06 — 2025.12',
		tag: '工作',
		title: '上海赛印软件 · 全栈工程师',
		body: '实验室 LIMS：委托订单、样品、检测、报告等核心业务前后端交付。',
	},
	{
		time: '2025.12 — 2026.01',
		tag: '工作',
		title: '南天信息 · 全栈工程师',
		body: '个人信贷 / 网贷系统前后端研发。',
	},
	{
		time: '2026 · Now',
		tag: '此刻',
		title: 'hongz · blog.hongz.cc',
		body: '用 Astro + Markdown 搭个人站，记录工程与折腾；日常 Cursor / Copilot / Dify 提效。技术栈：Java / Spring 全家桶、Vue / React、MySQL / Redis、Docker / Jenkins、规则引擎与微服务。',
	},
] as const;
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead
			title={`关于 · ${SITE_TITLE}`}
			description="秦鸿哲（hongz）时间轴：从专科到全栈 / 架构，金融 · V2X · 医疗 · 企业级系统"
		/>
	</head>
	<body>
		<Header />
		<main class="site-shell py-4 sm:py-12">
			<section class="panel relative px-3.5 py-6 sm:px-10 sm:py-10">
				<p class="hud-label m-0">Profile / Timeline</p>
				<h1 class="mt-2 mb-2 text-[1.6rem] font-bold tracking-tight text-[var(--ink)] sm:mt-3 sm:text-4xl">
					秦鸿哲 <span class="text-[var(--accent)]">/ hongz</span>
				</h1>
				<p class="m-0 text-sm text-[var(--muted)] sm:text-base">
					按时间往下看：从求学到全栈 / 架构，约 10 年
				</p>
				<p class="mt-3 mb-0 text-sm leading-relaxed text-[var(--ink)] sm:mt-4 sm:text-base">
					做过互联网金融、智能汽车（V2X/V2I）、医疗医保、停车充电、实验室信息化与科研申报。擅长 0→1
					架构、跨端联调与小团队交付。
				</p>
				<div class="mt-4 flex flex-col gap-2 sm:mt-5 sm:flex-row sm:flex-wrap sm:gap-3">
					<a class="btn-cyber btn-cyber-primary" href="mailto:hongzhe.qin@outlook.com">邮件联系</a>
					<a
						class="btn-cyber btn-cyber-ghost"
						href="https://github.com/hongzhe757"
						target="_blank"
						rel="noreferrer"
					>
						GitHub
					</a>
					<a class="btn-cyber btn-cyber-ghost" href="/blog">看文章</a>
				</div>
			</section>

			<section class="mt-6 sm:mt-10">
				<p class="hud-label m-0">Timeline</p>
				<h2 class="mt-1 mb-4 text-lg font-bold text-[var(--ink)] sm:mb-6 sm:text-2xl">时间轴</h2>

				<ol class="timeline m-0 list-none p-0">
					{
						timeline.map((item) => (
							<li class="timeline-item">
								<div class="timeline-rail" aria-hidden="true">
									<span class="timeline-dot" />
								</div>
								<div class="timeline-card panel">
									<div class="timeline-meta">
										<time class="mono text-[0.7rem] text-[var(--accent)] sm:text-xs">{item.time}</time>
										<span class="timeline-tag">{item.tag}</span>
									</div>
									<h3 class="mt-2 mb-1.5 text-base font-bold text-[var(--ink)] sm:text-lg">{item.title}</h3>
									<p class="m-0 text-sm leading-relaxed text-[var(--muted)]">{item.body}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="panel mt-8 px-3.5 py-5 sm:mt-12 sm:px-6 sm:py-6">
				<p class="hud-label m-0">Contact</p>
				<p class="mt-2 mb-0 text-sm text-[var(--muted)]">
					邮箱 <a href="mailto:hongzhe.qin@outlook.com">hongzhe.qin@outlook.com</a>
					· 本站 Astro + Pages · 评论 Giscus（GitHub 登录）
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.timeline {
		position: relative;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 1.1rem minmax(0, 1fr);
		gap: 0.75rem;
		align-items: stretch;
	}

	@media (min-width: 640px) {
		.timeline-item {
			grid-template-columns: 1.25rem minmax(0, 1fr);
			gap: 1.1rem;
		}
	}

	.timeline-rail {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.timeline-rail::before {
		content: '';
		position: absolute;
		top: 0.35rem;
		bottom: -0.35rem;
		width: 2px;
		background: linear-gradient(180deg, var(--accent), var(--line));
		opacity: 0.7;
	}

	.timeline-item:last-child .timeline-rail::before {
		bottom: 1.25rem;
	}

	.timeline-dot {
		position: relative;
		z-index: 1;
		margin-top: 0.85rem;
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 999px;
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent), var(--glow);
		flex-shrink: 0;
	}

	@supports not (background: color-mix(in srgb, red 50%, blue)) {
		.timeline-dot {
			box-shadow: 0 0 0 3px var(--accent-soft), var(--glow);
		}
	}

	.timeline-card {
		margin-bottom: 0.85rem;
		padding: 0.9rem 0.95rem;
	}

	@media (min-width: 640px) {
		.timeline-card {
			margin-bottom: 1.1rem;
			padding: 1.15rem 1.25rem;
		}
	}

	.timeline-item:last-child .timeline-card {
		margin-bottom: 0;
	}

	.timeline-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.65rem;
	}

	.timeline-tag {
		display: inline-flex;
		align-items: center;
		padding: 0.12rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--accent-soft);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
</style>
