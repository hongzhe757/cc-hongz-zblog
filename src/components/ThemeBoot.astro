---
/** 尽早应用皮肤，减少闪烁；放在 <head> */
---

<script is:inline>
	(function () {
		try {
			const root = document.documentElement;
			const legacy = {
				cyber: 'paper',
				ink: 'paper',
				ocean: 'mist',
				navy: 'mist',
				forest: 'olive',
				slate: 'olive',
				cinnabar: 'paper',
				amber: 'paper',
				'noir-red': 'paper',
			};
			const valid = ['paper', 'mist', 'olive', 'mono'];
			let mode = localStorage.getItem('theme') || 'light';
			let skin = localStorage.getItem('blog-skin') || 'paper';
			if (legacy[skin]) skin = legacy[skin];
			if (valid.indexOf(skin) === -1) skin = 'paper';
			localStorage.setItem('blog-skin', skin);
			root.classList.toggle('dark', mode === 'dark');
			root.setAttribute('data-skin', skin);
		} catch (_) {}
	})();
</script>
