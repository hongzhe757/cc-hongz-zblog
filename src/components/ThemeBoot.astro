---
/** 尽早应用皮肤，减少闪烁；放在 <head> */
---

<script is:inline>
	(function () {
		try {
			const root = document.documentElement;
			const mode = localStorage.getItem('theme') || 'dark';
			const skin = localStorage.getItem('blog-skin') || 'cyber';
			root.classList.toggle('dark', mode === 'dark');
			root.setAttribute('data-skin', skin);
		} catch (_) {}
	})();
</script>
