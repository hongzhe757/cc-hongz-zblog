---
/** 尽早应用皮肤，减少闪烁；放在 <head> */
---

<script is:inline>
	(function () {
		try {
			const root = document.documentElement;
			const legacy = {
				paper: 'studio',
				mist: 'studio',
				olive: 'orchard',
				mono: 'carbon',
				cyber: 'studio',
				ink: 'studio',
				ocean: 'studio',
				navy: 'studio',
				forest: 'orchard',
				slate: 'studio',
				cinnabar: 'studio',
				amber: 'studio',
				'noir-red': 'carbon',
			};
			const valid = ['studio', 'orchard', 'carbon'];
			let mode = localStorage.getItem('theme') || 'light';
			let skin = localStorage.getItem('blog-skin') || 'studio';
			if (legacy[skin]) skin = legacy[skin];
			if (valid.indexOf(skin) === -1) skin = 'studio';
			localStorage.setItem('blog-skin', skin);
			root.classList.toggle('dark', mode === 'dark');
			root.setAttribute('data-skin', skin);
		} catch (_) {}
	})();
</script>
