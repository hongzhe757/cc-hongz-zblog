---
/** 尽早应用皮肤，减少闪烁；放在 <head> */
---

<script is:inline>
	(function () {
		try {
			const root = document.documentElement;
			const legacy = {
				cyber: 'ink',
				navy: 'ocean',
				slate: 'forest',
				amber: 'cinnabar',
				'noir-red': 'cinnabar',
			};
			const valid = ['ink', 'ocean', 'forest', 'cinnabar', 'mono'];
			let mode = localStorage.getItem('theme') || 'light';
			let skin = localStorage.getItem('blog-skin') || 'ink';
			if (legacy[skin]) {
				skin = legacy[skin];
				localStorage.setItem('blog-skin', skin);
			}
			if (!valid.includes(skin)) skin = 'ink';
			root.classList.toggle('dark', mode === 'dark');
			root.setAttribute('data-skin', skin);
		} catch (_) {}
	})();
</script>
