---
interface Props {
	tags?: string[];
	class?: string;
}

const { tags = [], class: className = '' } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class:list={['tag-list', className]}>
			{tags.map((tag) => (
				<li>
					<a class="tag-chip" href={`/tags/${tag}/`}>
						#{tag}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tag-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 0.75rem;
		line-height: 1.4;
		text-decoration: none;
	}
	.tag-chip:hover {
		border-color: var(--accent);
		filter: none;
	}
</style>
