---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SkinSettings from './SkinSettings.astro';
---

<header class="site-header sticky top-0 z-40 border-b border-[var(--line)] bg-[color-mix(in_srgb,var(--bg-elevated)_88%,transparent)] backdrop-blur-md">
	<nav class="site-shell flex items-center justify-between gap-2 py-2.5 sm:py-3">
		<a href="/" class="group min-w-0 flex items-baseline gap-2 no-underline">
			<span class="truncate text-lg font-bold tracking-wide text-[var(--ink)] group-hover:text-[var(--accent)] sm:text-xl">
				{SITE_TITLE}
			</span>
			<span class="hidden text-sm text-[var(--muted)] md:inline">笔记 · 工程 · 折腾</span>
		</a>

		<div class="flex shrink-0 items-center gap-1.5">
			<div class="internal-links hidden items-center gap-1 text-sm font-semibold sm:flex">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<a
				class="hidden h-9 w-9 items-center justify-center rounded-full border border-[var(--line)] text-[var(--ink)] no-underline md:inline-flex"
				href="https://github.com/hongzhe757/cc-hongz-zblog"
				target="_blank"
				rel="noreferrer"
				title="GitHub"
			>
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<SkinSettings />
			<button
				id="nav-toggle"
				type="button"
				class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--line)] bg-[var(--bg-elevated)] text-[var(--ink)] sm:hidden"
				aria-label="打开菜单"
				aria-expanded="false"
				aria-controls="mobile-nav"
			>
				<span class="nav-icon-open" aria-hidden="true">☰</span>
				<span class="nav-icon-close hidden" aria-hidden="true">✕</span>
			</button>
		</div>
	</nav>

	<div id="mobile-nav" class="mobile-nav hidden border-t border-[var(--line)] sm:hidden">
		<div class="site-shell flex flex-col gap-1 py-3 text-base font-semibold">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<a
				class="rounded-lg px-3 py-2.5 text-[var(--ink)] no-underline"
				href="https://github.com/hongzhe757/cc-hongz-zblog"
				target="_blank"
				rel="noreferrer"
			>
				GitHub
			</a>
		</div>
	</div>
</header>

<style>
	.internal-links :global(a) {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.7rem;
		border-radius: 999px;
		color: var(--ink);
		text-decoration: none;
		border: 1px solid transparent;
	}
	.internal-links :global(a.active),
	.internal-links :global(a:hover) {
		background: var(--accent-soft);
		border-color: color-mix(in srgb, var(--accent) 25%, transparent);
		color: var(--accent);
	}
	.mobile-nav :global(a) {
		display: block;
		padding: 0.7rem 0.85rem;
		border-radius: 10px;
		color: var(--ink);
		text-decoration: none;
	}
	.mobile-nav :global(a.active),
	.mobile-nav :global(a:hover) {
		background: var(--accent-soft);
		color: var(--accent);
	}
</style>

<script is:inline>
	(function () {
		const toggle = document.getElementById('nav-toggle');
		const panel = document.getElementById('mobile-nav');
		const openIcon = toggle?.querySelector('.nav-icon-open');
		const closeIcon = toggle?.querySelector('.nav-icon-close');
		toggle?.addEventListener('click', () => {
			const open = panel?.classList.toggle('hidden') === false;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
			openIcon?.classList.toggle('hidden', open);
			closeIcon?.classList.toggle('hidden', !open);
		});
	})();
</script>
