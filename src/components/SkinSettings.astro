---
const skins = [
	{
		id: 'studio',
		label: '工坊',
		swatch: '#1f5fbf',
		preview: 'linear-gradient(135deg, #1f5fbf 0%, #7eb0ff 55%, #d9e6fb 100%)',
	},
	{
		id: 'orchard',
		label: '苔原',
		swatch: '#2f6a3a',
		preview: 'linear-gradient(135deg, #2f6a3a 0%, #8fd19a 55%, #d7ebd8 100%)',
	},
	{
		id: 'carbon',
		label: '碳墨',
		swatch: '#222222',
		preview: 'linear-gradient(135deg, #111 0%, #555 50%, #ececec 100%)',
	},
] as const;
---

<div class="skin-wrap">
	<button
		type="button"
		id="skin-toggle"
		class="skin-toggle"
		aria-expanded="false"
		aria-controls="skin-panel"
		aria-haspopup="true"
		title="外观设置"
		aria-label="外观设置"
	>
		<svg class="skin-toggle-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<!-- palette (stroke) -->
			<path
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M12 3.2c-4.7 0-8.5 3.5-8.5 7.9 0 3 1.8 5.6 4.5 6.9.35.17.75-.08.75-.47l.05-.35c.12-.72.78-1.18 1.5-.98 3 .75 5.7-1.55 5.7-4.6 0-4.1-1.8-7.4-4-7.4Z"
			/>
			<circle cx="8.2" cy="11.2" r="1.05" fill="currentColor" />
			<circle cx="11.1" cy="8.6" r="1.05" fill="currentColor" />
			<circle cx="14.6" cy="8.6" r="1.05" fill="currentColor" />
			<circle cx="16.4" cy="11.6" r="1.05" fill="currentColor" />
		</svg>
	</button>

	<div id="skin-panel" class="skin-panel" hidden role="group" aria-label="外观">
		<p class="skin-panel-label">明暗</p>
		<div class="skin-row mode-row" role="group" aria-label="明暗模式">
			<button type="button" class="mode-chip" data-mode="light" title="浅色" aria-label="浅色">
				<svg class="mode-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M12 2.5v1.8M12 19.7v1.8M2.5 12h1.8M19.7 12h1.8M5.05 5.05l1.27 1.27M17.68 17.68l1.27 1.27M17.68 5.05l-1.27 1.27M6.32 17.68l-1.27 1.27"
					/>
				</svg>
				<span>浅色</span>
			</button>
			<button type="button" class="mode-chip" data-mode="dark" title="深色" aria-label="深色">
				<svg class="mode-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M20.2 13.35A7.85 7.85 0 0 1 10.65 3.8 7.9 7.9 0 1 0 20.2 13.35Z"
					/>
				</svg>
				<span>深色</span>
			</button>
		</div>

		<p class="skin-panel-label">皮肤</p>
		<div class="skin-row skins">
			{
				skins.map((skin) => (
					<button
						type="button"
						class="skin-chip"
						data-skin={skin.id}
						title={skin.label}
						aria-label={skin.label}
						style={`--swatch:${skin.swatch};--preview:${skin.preview}`}
					>
						<span class="skin-swatch" aria-hidden="true">
							<span class="skin-check">
								<svg viewBox="0 0 16 16" width="10" height="10">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="2.2"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3.5 8.2 6.6 11.2 12.5 4.8"
									/>
								</svg>
							</span>
						</span>
						<span class="skin-name">{skin.label}</span>
					</button>
				))
			}
		</div>
	</div>
</div>

<style>
	.skin-wrap {
		position: relative;
	}

	.skin-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		margin: 0;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg-elevated);
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color 0.18s ease,
			background 0.18s ease,
			color 0.18s ease,
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}
	.skin-toggle:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		color: var(--accent);
		transform: translateY(-1px);
	}
	.skin-toggle[aria-expanded='true'] {
		border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
		background: var(--accent-soft);
		color: var(--accent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 16%, transparent);
	}
	.skin-toggle-icon {
		display: block;
	}

	.skin-panel {
		position: absolute;
		top: calc(100% + 0.45rem);
		right: 0;
		z-index: 60;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		width: 12.75rem;
		padding: 0.7rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: color-mix(in srgb, var(--bg-elevated) 94%, transparent);
		backdrop-filter: blur(12px);
		box-shadow: var(--shadow);
	}
	.skin-panel[hidden] {
		display: none !important;
	}
	.skin-panel-label {
		margin: 0;
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.skin-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.mode-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.25rem;
		padding: 0.22rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: color-mix(in srgb, var(--bg) 88%, var(--ink) 4%);
	}

	.mode-chip,
	.skin-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.05rem;
		margin: 0;
		padding: 0.3rem 0.55rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg);
		color: var(--muted);
		cursor: pointer;
		line-height: 1;
		font-size: 0.78rem;
		transition:
			border-color 0.16s ease,
			background 0.16s ease,
			color 0.16s ease,
			box-shadow 0.16s ease,
			transform 0.16s ease;
	}
	.mode-chip {
		border: 0;
		border-radius: 9px;
		background: transparent;
		box-shadow: none;
		min-height: 2rem;
		padding: 0.35rem 0.4rem;
	}
	.mode-chip:hover,
	.skin-chip:hover {
		border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
		color: var(--ink);
		transform: translateY(-1px);
	}
	.mode-chip:hover {
		border-color: transparent;
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
		transform: none;
	}
	.mode-chip.is-active,
	.skin-chip.is-active {
		border-color: color-mix(in srgb, var(--accent) 65%, var(--line));
		background: var(--accent-soft);
		color: var(--accent);
	}
	.mode-chip.is-active {
		border-color: transparent;
		background: var(--bg-elevated);
		color: var(--accent);
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.06),
			0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent);
	}
	.mode-icon {
		display: block;
		flex-shrink: 0;
		width: 1.05rem;
		height: 1.05rem;
	}
	.mode-chip span {
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.skin-chip {
		flex: 1 1 100%;
		justify-content: flex-start;
		padding-left: 0.45rem;
	}
	.skin-swatch {
		position: relative;
		display: grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 8px;
		background: var(--preview);
		border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.22),
			0 1px 2px rgba(0, 0, 0, 0.08);
		flex-shrink: 0;
		overflow: hidden;
	}
	.skin-check {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--swatch) 42%, rgba(0, 0, 0, 0.45));
		color: #fff;
		opacity: 0;
		transform: scale(0.78);
		transition:
			opacity 0.16s ease,
			transform 0.16s ease;
	}
	.skin-chip.is-active .skin-check {
		opacity: 1;
		transform: scale(1);
	}
	.skin-name {
		color: inherit;
		font-weight: 600;
	}
</style>

<script is:inline>
	(function () {
		const root = document.documentElement;
		const SKIN_KEY = 'blog-skin';
		const MODE_KEY = 'theme';
		const validSkins = ['studio', 'orchard', 'carbon'];
		const legacy = {
			paper: 'studio',
			mist: 'studio',
			olive: 'orchard',
			mono: 'carbon',
			cyber: 'studio',
			ink: 'studio',
			ocean: 'studio',
			navy: 'studio',
			forest: 'orchard',
			slate: 'studio',
			cinnabar: 'studio',
			amber: 'studio',
			'noir-red': 'carbon',
		};

		const toggle = document.getElementById('skin-toggle');
		const panel = document.getElementById('skin-panel');

		function setOpen(open) {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.hidden = !open;
		}

		function syncUi(mode, skin) {
			document.querySelectorAll('.mode-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-mode') === mode);
			});
			document.querySelectorAll('.skin-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-skin') === skin);
			});
		}

		function notifyAppearance(mode, skin) {
			try {
				window.dispatchEvent(
					new CustomEvent('blog:appearance', {
						detail: { mode, skin },
					}),
				);
			} catch (_) {}
			if (typeof window.__blogSyncGiscus === 'function') {
				window.__blogSyncGiscus(mode);
			} else {
				const frame = document.querySelector('iframe.giscus-frame');
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage(
						{
							giscus: {
								setConfig: {
									theme: mode === 'dark' ? 'noborder_dark' : 'noborder_light',
								},
							},
						},
						'https://giscus.app',
					);
				}
			}
		}

		function applyMode(mode) {
			const next = mode === 'dark' ? 'dark' : 'light';
			root.classList.toggle('dark', next === 'dark');
			try {
				localStorage.setItem(MODE_KEY, next);
			} catch (_) {}
			const skin = root.getAttribute('data-skin') || 'carbon';
			syncUi(next, skin);
			notifyAppearance(next, skin);
		}

		function applySkin(skin) {
			let next = legacy[skin] || skin;
			if (validSkins.indexOf(next) === -1) next = 'carbon';
			root.setAttribute('data-skin', next);
			try {
				localStorage.setItem(SKIN_KEY, next);
			} catch (_) {}
			const mode = root.classList.contains('dark') ? 'dark' : 'light';
			syncUi(mode, next);
			notifyAppearance(mode, next);
		}

		function boot() {
			let mode = 'dark';
			let skin = 'carbon';
			try {
				mode = localStorage.getItem(MODE_KEY) || 'dark';
				skin = localStorage.getItem(SKIN_KEY) || 'carbon';
			} catch (_) {}
			applyMode(mode);
			applySkin(skin);
			setOpen(false);
		}

		boot();

		toggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		document.addEventListener('click', (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			if (t.closest('.skin-wrap')) {
				const modeBtn = t.closest('.mode-chip');
				if (modeBtn) {
					applyMode(modeBtn.getAttribute('data-mode') || 'dark');
					return;
				}
				const skinBtn = t.closest('.skin-chip');
				if (skinBtn) {
					applySkin(skinBtn.getAttribute('data-skin') || 'carbon');
					setOpen(false);
				}
				return;
			}
			setOpen(false);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	})();
</script>
