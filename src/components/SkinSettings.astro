---
const skins = [
	{
		id: 'studio',
		label: '工坊',
		swatch: '#1f5fbf',
		preview: 'linear-gradient(135deg, #1f5fbf 0%, #7eb0ff 55%, #d9e6fb 100%)',
	},
	{
		id: 'orchard',
		label: '苔原',
		swatch: '#2f6a3a',
		preview: 'linear-gradient(135deg, #2f6a3a 0%, #8fd19a 55%, #d7ebd8 100%)',
	},
	{
		id: 'carbon',
		label: '碳墨',
		swatch: '#222222',
		preview: 'linear-gradient(135deg, #111 0%, #555 50%, #ececec 100%)',
	},
] as const;
---

<div class="skin-wrap">
	<button
		type="button"
		id="skin-toggle"
		class="skin-toggle"
		aria-expanded="false"
		aria-controls="skin-panel"
		aria-haspopup="true"
		title="外观设置"
		aria-label="外观设置"
	>
		<span class="skin-toggle-ring" id="skin-toggle-ring" aria-hidden="true">
			<span class="skin-toggle-core" id="skin-toggle-core"></span>
		</span>
		<svg class="skin-toggle-glyph" id="skin-toggle-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
			<!-- sun by default; JS swaps path for moon -->
			<path
				id="skin-toggle-glyph-path"
				fill="currentColor"
				d="M12 4.2a1 1 0 0 1 1 1V7a1 1 0 1 1-2 0V5.2a1 1 0 0 1 1-1Zm0 11.3a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.8-4.5a1 1 0 0 1-1 1H17a1 1 0 1 1 0-2h1.8a1 1 0 0 1 1 1ZM7 12a1 1 0 0 1-1 1H4.2a1 1 0 1 1 0-2H6a1 1 0 0 1 1 1Zm9.95 5.36a1 1 0 0 1-1.41 0l-1.27-1.27a1 1 0 1 1 1.41-1.41l1.27 1.27a1 1 0 0 1 0 1.41ZM9.73 9.32a1 1 0 0 1-1.41 0L7.05 8.05A1 1 0 0 1 8.46 6.6l1.27 1.27a1 1 0 0 1 0 1.41Zm0 5.36a1 1 0 0 1 0 1.41L8.46 17.4A1 1 0 1 1 7.05 16l1.27-1.27a1 1 0 0 1 1.41 0Zm5.36-5.36a1 1 0 0 1 0-1.41L16 6.64a1 1 0 0 1 1.41 1.41l-1.27 1.27a1 1 0 0 1-1.41 0ZM12 17a1 1 0 0 1 1 1v1.8a1 1 0 1 1-2 0V18a1 1 0 0 1 1-1Z"
			/>
		</svg>
	</button>

	<div id="skin-panel" class="skin-panel" hidden role="group" aria-label="外观">
		<p class="skin-panel-label">明暗</p>
		<div class="skin-row mode-row">
			<button type="button" class="mode-chip" data-mode="light" title="浅色" aria-label="浅色">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 4.2a1 1 0 0 1 1 1V7a1 1 0 1 1-2 0V5.2a1 1 0 0 1 1-1Zm0 11.3a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.8-4.5a1 1 0 0 1-1 1H17a1 1 0 1 1 0-2h1.8a1 1 0 0 1 1 1ZM7 12a1 1 0 0 1-1 1H4.2a1 1 0 1 1 0-2H6a1 1 0 0 1 1 1Zm9.95 5.36a1 1 0 0 1-1.41 0l-1.27-1.27a1 1 0 1 1 1.41-1.41l1.27 1.27a1 1 0 0 1 0 1.41ZM9.73 9.32a1 1 0 0 1-1.41 0L7.05 8.05A1 1 0 0 1 8.46 6.6l1.27 1.27a1 1 0 0 1 0 1.41Zm0 5.36a1 1 0 0 1 0 1.41L8.46 17.4A1 1 0 1 1 7.05 16l1.27-1.27a1 1 0 0 1 1.41 0Zm5.36-5.36a1 1 0 0 1 0-1.41L16 6.64a1 1 0 0 1 1.41 1.41l-1.27 1.27a1 1 0 0 1-1.41 0ZM12 17a1 1 0 0 1 1 1v1.8a1 1 0 1 1-2 0V18a1 1 0 0 1 1-1Z"
					/>
				</svg>
				<span>浅色</span>
			</button>
			<button type="button" class="mode-chip" data-mode="dark" title="深色" aria-label="深色">
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
					<path
						fill="currentColor"
						d="M14.8 3.1a1 1 0 0 1 1.1 1.4A7.6 7.6 0 1 0 19.5 16a1 1 0 0 1 1.5 1.1A9.6 9.6 0 1 1 13.4 3a1 1 0 0 1 1.4.1Z"
					/>
				</svg>
				<span>深色</span>
			</button>
		</div>

		<p class="skin-panel-label">皮肤</p>
		<div class="skin-row skins">
			{
				skins.map((skin) => (
					<button
						type="button"
						class="skin-chip"
						data-skin={skin.id}
						title={skin.label}
						aria-label={skin.label}
						style={`--swatch:${skin.swatch};--preview:${skin.preview}`}
					>
						<span class="skin-swatch" aria-hidden="true">
							<span class="skin-check">
								<svg viewBox="0 0 16 16" width="10" height="10">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="2.2"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3.5 8.2 6.6 11.2 12.5 4.8"
									/>
								</svg>
							</span>
						</span>
						<span class="skin-name">{skin.label}</span>
					</button>
				))
			}
		</div>
	</div>
</div>

<style>
	.skin-wrap {
		position: relative;
	}

	.skin-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 2.45rem;
		height: 2.2rem;
		margin: 0;
		padding: 0 0.35rem;
		border: 1px solid var(--line);
		border-radius: 11px;
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--bg-elevated) 92%, white), var(--bg-elevated));
		color: var(--ink);
		cursor: pointer;
		box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 6%, transparent);
		transition:
			border-color 0.18s ease,
			background 0.18s ease,
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}
	.skin-toggle:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		transform: translateY(-1px);
	}
	.skin-toggle[aria-expanded='true'] {
		border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
		background: var(--accent-soft);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
	}

	.skin-toggle-ring {
		position: relative;
		display: grid;
		place-items: center;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 999px;
		background: conic-gradient(from 210deg, #1f5fbf, #2f6a3a, #555, #1f5fbf);
		padding: 2px;
		flex-shrink: 0;
	}
	.skin-toggle-core {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28);
	}
	.skin-toggle-glyph {
		flex-shrink: 0;
		color: var(--muted);
		opacity: 0.95;
	}

	.skin-panel {
		position: absolute;
		top: calc(100% + 0.45rem);
		right: 0;
		z-index: 60;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		width: 12.75rem;
		padding: 0.7rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: color-mix(in srgb, var(--bg-elevated) 94%, transparent);
		backdrop-filter: blur(12px);
		box-shadow: var(--shadow);
	}
	.skin-panel[hidden] {
		display: none !important;
	}
	.skin-panel-label {
		margin: 0;
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.skin-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.mode-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.35rem;
	}

	.mode-chip,
	.skin-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.05rem;
		margin: 0;
		padding: 0.3rem 0.55rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg);
		color: var(--muted);
		cursor: pointer;
		line-height: 1;
		font-size: 0.78rem;
		transition:
			border-color 0.16s ease,
			background 0.16s ease,
			color 0.16s ease,
			transform 0.16s ease;
	}
	.mode-chip:hover,
	.skin-chip:hover {
		border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
		color: var(--ink);
		transform: translateY(-1px);
	}
	.mode-chip.is-active,
	.skin-chip.is-active {
		border-color: color-mix(in srgb, var(--accent) 65%, var(--line));
		background: var(--accent-soft);
		color: var(--accent);
	}
	.mode-chip svg {
		flex-shrink: 0;
	}

	.skin-chip {
		flex: 1 1 100%;
		justify-content: flex-start;
		padding-left: 0.45rem;
	}
	.skin-swatch {
		position: relative;
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 8px;
		background: var(--preview);
		border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.22),
			0 1px 2px rgba(0, 0, 0, 0.08);
		flex-shrink: 0;
	}
	.skin-check {
		display: grid;
		place-items: center;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
		color: var(--accent);
		opacity: 0;
		transform: scale(0.7);
		transition:
			opacity 0.16s ease,
			transform 0.16s ease;
	}
	.skin-chip.is-active .skin-check {
		opacity: 1;
		transform: scale(1);
	}
	.skin-name {
		color: inherit;
		font-weight: 600;
	}
</style>

<script is:inline>
	(function () {
		const root = document.documentElement;
		const SKIN_KEY = 'blog-skin';
		const MODE_KEY = 'theme';
		const validSkins = ['studio', 'orchard', 'carbon'];
		const swatches = { studio: '#1f5fbf', orchard: '#2f6a3a', carbon: '#222222' };
		const sunPath =
			'M12 4.2a1 1 0 0 1 1 1V7a1 1 0 1 1-2 0V5.2a1 1 0 0 1 1-1Zm0 11.3a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.8-4.5a1 1 0 0 1-1 1H17a1 1 0 1 1 0-2h1.8a1 1 0 0 1 1 1ZM7 12a1 1 0 0 1-1 1H4.2a1 1 0 1 1 0-2H6a1 1 0 0 1 1 1Zm9.95 5.36a1 1 0 0 1-1.41 0l-1.27-1.27a1 1 0 1 1 1.41-1.41l1.27 1.27a1 1 0 0 1 0 1.41ZM9.73 9.32a1 1 0 0 1-1.41 0L7.05 8.05A1 1 0 0 1 8.46 6.6l1.27 1.27a1 1 0 0 1 0 1.41Zm0 5.36a1 1 0 0 1 0 1.41L8.46 17.4A1 1 0 1 1 7.05 16l1.27-1.27a1 1 0 0 1 1.41 0Zm5.36-5.36a1 1 0 0 1 0-1.41L16 6.64a1 1 0 0 1 1.41 1.41l-1.27 1.27a1 1 0 0 1-1.41 0ZM12 17a1 1 0 0 1 1 1v1.8a1 1 0 1 1-2 0V18a1 1 0 0 1 1-1Z';
		const moonPath =
			'M14.8 3.1a1 1 0 0 1 1.1 1.4A7.6 7.6 0 1 0 19.5 16a1 1 0 0 1 1.5 1.1A9.6 9.6 0 1 1 13.4 3a1 1 0 0 1 1.4.1Z';
		const legacy = {
			paper: 'studio',
			mist: 'studio',
			olive: 'orchard',
			mono: 'carbon',
			cyber: 'studio',
			ink: 'studio',
			ocean: 'studio',
			navy: 'studio',
			forest: 'orchard',
			slate: 'studio',
			cinnabar: 'studio',
			amber: 'studio',
			'noir-red': 'carbon',
		};

		const toggle = document.getElementById('skin-toggle');
		const panel = document.getElementById('skin-panel');
		const toggleCore = document.getElementById('skin-toggle-core');
		const glyphPath = document.getElementById('skin-toggle-glyph-path');

		function setOpen(open) {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.hidden = !open;
		}

		function syncUi(mode, skin) {
			document.querySelectorAll('.mode-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-mode') === mode);
			});
			document.querySelectorAll('.skin-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-skin') === skin);
			});
			if (toggleCore) toggleCore.style.background = swatches[skin] || swatches.studio;
			if (glyphPath) glyphPath.setAttribute('d', mode === 'dark' ? moonPath : sunPath);
		}

		function notifyAppearance(mode, skin) {
			try {
				window.dispatchEvent(
					new CustomEvent('blog:appearance', {
						detail: { mode, skin },
					}),
				);
			} catch (_) {}
			if (typeof window.__blogSyncGiscus === 'function') {
				window.__blogSyncGiscus(mode);
			} else {
				const frame = document.querySelector('iframe.giscus-frame');
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage(
						{
							giscus: {
								setConfig: {
									theme: mode === 'dark' ? 'noborder_dark' : 'noborder_light',
								},
							},
						},
						'https://giscus.app',
					);
				}
			}
		}

		function applyMode(mode) {
			const next = mode === 'dark' ? 'dark' : 'light';
			root.classList.toggle('dark', next === 'dark');
			try {
				localStorage.setItem(MODE_KEY, next);
			} catch (_) {}
			const skin = root.getAttribute('data-skin') || 'studio';
			syncUi(next, skin);
			notifyAppearance(next, skin);
		}

		function applySkin(skin) {
			let next = legacy[skin] || skin;
			if (validSkins.indexOf(next) === -1) next = 'studio';
			root.setAttribute('data-skin', next);
			try {
				localStorage.setItem(SKIN_KEY, next);
			} catch (_) {}
			const mode = root.classList.contains('dark') ? 'dark' : 'light';
			syncUi(mode, next);
			notifyAppearance(mode, next);
		}

		function boot() {
			let mode = 'light';
			let skin = 'studio';
			try {
				mode = localStorage.getItem(MODE_KEY) || 'light';
				skin = localStorage.getItem(SKIN_KEY) || 'studio';
			} catch (_) {}
			applyMode(mode);
			applySkin(skin);
			setOpen(false);
		}

		boot();

		toggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		document.addEventListener('click', (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			if (t.closest('.skin-wrap')) {
				const modeBtn = t.closest('.mode-chip');
				if (modeBtn) {
					applyMode(modeBtn.getAttribute('data-mode') || 'light');
					return;
				}
				const skinBtn = t.closest('.skin-chip');
				if (skinBtn) {
					applySkin(skinBtn.getAttribute('data-skin') || 'studio');
					setOpen(false);
				}
				return;
			}
			setOpen(false);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	})();
</script>
