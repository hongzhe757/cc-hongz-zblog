---
const skins = [
	{ id: 'studio', label: '工坊', swatch: '#1f5fbf' },
	{ id: 'orchard', label: '苔原', swatch: '#2f6a3a' },
	{ id: 'carbon', label: '碳墨', swatch: '#222222' },
] as const;
---

<div class="skin-bar" role="group" aria-label="外观">
	<button type="button" class="mode-chip" data-mode="light" title="浅色" aria-label="浅色">☀</button>
	<button type="button" class="mode-chip" data-mode="dark" title="深色" aria-label="深色">☾</button>
	<span class="skin-sep" aria-hidden="true"></span>
	{
		skins.map((skin) => (
			<button
				type="button"
				class="skin-chip"
				data-skin={skin.id}
				title={skin.label}
				aria-label={skin.label}
				style={`--swatch:${skin.swatch}`}
			>
				<span class="skin-dot" aria-hidden="true" />
			</button>
		))
	}
</div>

<style>
	.skin-bar {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.22rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
		backdrop-filter: blur(8px);
	}
	.mode-chip,
	.skin-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		margin: 0;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		line-height: 1;
		font-size: 0.85rem;
	}
	.mode-chip.is-active,
	.skin-chip.is-active {
		border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
		background: var(--accent-soft);
		color: var(--accent);
	}
	.skin-sep {
		width: 1px;
		height: 1rem;
		margin: 0 0.12rem;
		background: var(--line);
	}
	.skin-dot {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 999px;
		background: var(--swatch);
		border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
	}
	.skin-chip.is-active .skin-dot {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
</style>

<script is:inline>
	(function () {
		const root = document.documentElement;
		const SKIN_KEY = 'blog-skin';
		const MODE_KEY = 'theme';
		const validSkins = ['studio', 'orchard', 'carbon'];
		const legacy = {
			paper: 'studio',
			mist: 'studio',
			olive: 'orchard',
			mono: 'carbon',
			cyber: 'studio',
			ink: 'studio',
			ocean: 'studio',
			navy: 'studio',
			forest: 'orchard',
			slate: 'studio',
			cinnabar: 'studio',
			amber: 'studio',
			'noir-red': 'carbon',
		};

		function syncUi(mode, skin) {
			document.querySelectorAll('.mode-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-mode') === mode);
			});
			document.querySelectorAll('.skin-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-skin') === skin);
			});
		}

		function notifyAppearance(mode, skin) {
			try {
				window.dispatchEvent(
					new CustomEvent('blog:appearance', {
						detail: { mode, skin },
					}),
				);
			} catch (_) {}
			if (typeof window.__blogSyncGiscus === 'function') {
				window.__blogSyncGiscus(mode);
			} else {
				const frame = document.querySelector('iframe.giscus-frame');
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage(
						{
							giscus: {
								setConfig: {
									theme: mode === 'dark' ? 'noborder_dark' : 'noborder_light',
								},
							},
						},
						'https://giscus.app',
					);
				}
			}
		}

		function applyMode(mode) {
			const next = mode === 'dark' ? 'dark' : 'light';
			root.classList.toggle('dark', next === 'dark');
			try {
				localStorage.setItem(MODE_KEY, next);
			} catch (_) {}
			const skin = root.getAttribute('data-skin') || 'studio';
			syncUi(next, skin);
			notifyAppearance(next, skin);
		}

		function applySkin(skin) {
			let next = legacy[skin] || skin;
			if (validSkins.indexOf(next) === -1) next = 'studio';
			root.setAttribute('data-skin', next);
			try {
				localStorage.setItem(SKIN_KEY, next);
			} catch (_) {}
			const mode = root.classList.contains('dark') ? 'dark' : 'light';
			syncUi(mode, next);
			notifyAppearance(mode, next);
		}

		function boot() {
			let mode = 'light';
			let skin = 'studio';
			try {
				mode = localStorage.getItem(MODE_KEY) || 'light';
				skin = localStorage.getItem(SKIN_KEY) || 'studio';
			} catch (_) {}
			applyMode(mode);
			applySkin(skin);
		}

		boot();

		document.addEventListener('click', (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			const modeBtn = t.closest('.mode-chip');
			if (modeBtn) {
				applyMode(modeBtn.getAttribute('data-mode') || 'light');
				return;
			}
			const skinBtn = t.closest('.skin-chip');
			if (skinBtn) {
				applySkin(skinBtn.getAttribute('data-skin') || 'studio');
			}
		});
	})();
</script>
