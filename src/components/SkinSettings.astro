---
const skins = [
	{ id: 'paper', label: '纸白', swatch: '#4338ca' },
	{ id: 'mist', label: '雾蓝', swatch: '#0369a1' },
	{ id: 'olive', label: '橄榄', swatch: '#3f6212' },
	{ id: 'mono', label: '黑白', swatch: '#171717' },
] as const;
---

<div class="skin-settings relative">
	<button
		id="skin-settings-btn"
		type="button"
		class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--line)] bg-[var(--bg-elevated)] text-sm text-[var(--ink)] transition hover:border-[var(--accent)] sm:w-auto sm:gap-1.5 sm:px-3"
		aria-haspopup="dialog"
		aria-expanded="false"
		aria-controls="skin-settings-panel"
		title="外观"
	>
		<span aria-hidden="true">◐</span>
		<span class="hidden sm:inline">外观</span>
	</button>

	<div
		id="skin-settings-panel"
		class="fixed inset-x-3 top-[3.75rem] z-50 hidden max-h-[min(70vh,28rem)] w-auto overflow-y-auto rounded-xl border border-[var(--line)] bg-[var(--bg-elevated)] p-3 shadow-[var(--shadow)] sm:absolute sm:inset-x-auto sm:right-0 sm:top-[calc(100%+0.5rem)] sm:max-h-none sm:w-60 sm:overflow-visible"
		role="dialog"
		aria-label="外观设置"
	>
		<p class="m-0 mb-2 text-xs font-medium text-[var(--muted)]">明暗</p>
		<div class="mb-3 grid grid-cols-2 gap-2">
			<button type="button" data-mode="light" class="mode-btn rounded-lg border border-[var(--line)] px-2 py-1.5 text-sm text-[var(--ink)]">
				浅色
			</button>
			<button type="button" data-mode="dark" class="mode-btn rounded-lg border border-[var(--line)] px-2 py-1.5 text-sm text-[var(--ink)]">
				深色
			</button>
		</div>

		<p class="m-0 mb-2 text-xs font-medium text-[var(--muted)]">配色</p>
		<div class="grid grid-cols-1 gap-1.5">
			{
				skins.map((skin) => (
					<button
						type="button"
						data-skin={skin.id}
						class="skin-btn flex items-center gap-2 rounded-lg border border-[var(--line)] px-2.5 py-2 text-left text-sm text-[var(--ink)] transition hover:border-[var(--accent)]"
					>
						<span
							class="inline-block h-3.5 w-3.5 rounded-full border border-[var(--line)]"
							style={`background:${skin.swatch}`}
							aria-hidden="true"
						/>
						<span>{skin.label}</span>
						<span class="skin-check ml-auto hidden text-[var(--accent)]">✓</span>
					</button>
				))
			}
		</div>
	</div>
</div>

<style>
	.mode-btn.is-active,
	.skin-btn.is-active {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent);
	}
	.skin-btn.is-active .skin-check {
		display: inline;
	}
</style>

<script is:inline>
	(function () {
		const root = document.documentElement;
		const SKIN_KEY = 'blog-skin';
		const MODE_KEY = 'theme';
		const validSkins = ['paper', 'mist', 'olive', 'mono'];
		const legacy = {
			cyber: 'paper',
			ink: 'paper',
			ocean: 'mist',
			navy: 'mist',
			forest: 'olive',
			slate: 'olive',
			cinnabar: 'paper',
			amber: 'paper',
			'noir-red': 'paper',
		};

		function applyMode(mode) {
			root.classList.toggle('dark', mode === 'dark');
			localStorage.setItem(MODE_KEY, mode);
			document.querySelectorAll('.mode-btn').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-mode') === mode);
			});
			const frame = document.querySelector('iframe.giscus-frame');
			if (frame) {
				frame.contentWindow?.postMessage(
					{ giscus: { setConfig: { theme: mode === 'dark' ? 'dark' : 'light' } } },
					'https://giscus.app',
				);
			}
		}

		function applySkin(skin) {
			let next = legacy[skin] || skin;
			if (!validSkins.includes(next)) next = 'paper';
			root.setAttribute('data-skin', next);
			localStorage.setItem(SKIN_KEY, next);
			document.querySelectorAll('.skin-btn').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-skin') === next);
			});
		}

		applyMode(localStorage.getItem(MODE_KEY) || 'light');
		applySkin(localStorage.getItem(SKIN_KEY) || 'paper');

		const btn = document.getElementById('skin-settings-btn');
		const panel = document.getElementById('skin-settings-panel');
		btn?.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = panel?.classList.toggle('hidden') === false;
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
		});
		document.addEventListener('click', (e) => {
			if (!panel || panel.classList.contains('hidden')) return;
			if (panel.contains(e.target) || btn?.contains(e.target)) return;
			panel.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
		});

		document.querySelectorAll('.mode-btn').forEach((el) => {
			el.addEventListener('click', () => applyMode(el.getAttribute('data-mode') || 'light'));
		});
		document.querySelectorAll('.skin-btn').forEach((el) => {
			el.addEventListener('click', () => applySkin(el.getAttribute('data-skin') || 'paper'));
		});
	})();
</script>
