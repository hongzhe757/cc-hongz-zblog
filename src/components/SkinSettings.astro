---
const skins = [
	{ id: 'studio', label: '工坊', swatch: '#1f5fbf' },
	{ id: 'orchard', label: '苔原', swatch: '#2f6a3a' },
	{ id: 'carbon', label: '碳墨', swatch: '#222222' },
] as const;
---

<div class="skin-wrap">
	<button
		type="button"
		id="skin-toggle"
		class="skin-toggle"
		aria-expanded="false"
		aria-controls="skin-panel"
		aria-haspopup="true"
		title="外观设置"
		aria-label="外观设置"
	>
		<span class="skin-toggle-dot" id="skin-toggle-dot" aria-hidden="true"></span>
		<span class="skin-toggle-mode" id="skin-toggle-mode" aria-hidden="true">☀</span>
	</button>

	<div id="skin-panel" class="skin-panel" hidden role="group" aria-label="外观">
		<div class="skin-row">
			<button type="button" class="mode-chip" data-mode="light" title="浅色" aria-label="浅色">☀ 浅色</button>
			<button type="button" class="mode-chip" data-mode="dark" title="深色" aria-label="深色">☾ 深色</button>
		</div>
		<div class="skin-row skins">
			{
				skins.map((skin) => (
					<button
						type="button"
						class="skin-chip"
						data-skin={skin.id}
						title={skin.label}
						aria-label={skin.label}
						style={`--swatch:${skin.swatch}`}
					>
						<span class="skin-dot" aria-hidden="true" />
						<span class="skin-name">{skin.label}</span>
					</button>
				))
			}
		</div>
	</div>
</div>

<style>
	.skin-wrap {
		position: relative;
	}
	.skin-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 2.45rem;
		height: 2.2rem;
		margin: 0;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg-elevated);
		color: var(--ink);
		cursor: pointer;
	}
	.skin-toggle[aria-expanded='true'] {
		border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
		background: var(--accent-soft);
	}
	.skin-toggle-dot {
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 999px;
		background: var(--accent);
		border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
	}
	.skin-toggle-mode {
		font-size: 0.78rem;
		line-height: 1;
		color: var(--muted);
	}
	.skin-panel {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		z-index: 60;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 11.5rem;
		padding: 0.55rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--bg-elevated);
		box-shadow: var(--shadow);
	}
	.skin-panel[hidden] {
		display: none !important;
	}
	.skin-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.mode-chip,
	.skin-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 1.95rem;
		margin: 0;
		padding: 0.25rem 0.55rem;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		line-height: 1;
		font-size: 0.78rem;
	}
	.skin-chip {
		flex: 1 1 auto;
		justify-content: flex-start;
	}
	.mode-chip.is-active,
	.skin-chip.is-active {
		border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
		background: var(--accent-soft);
		color: var(--accent);
	}
	.skin-dot {
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 999px;
		background: var(--swatch);
		border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
		flex-shrink: 0;
	}
	.skin-name {
		color: inherit;
	}
</style>

<script is:inline>
	(function () {
		const root = document.documentElement;
		const SKIN_KEY = 'blog-skin';
		const MODE_KEY = 'theme';
		const validSkins = ['studio', 'orchard', 'carbon'];
		const swatches = { studio: '#1f5fbf', orchard: '#2f6a3a', carbon: '#222222' };
		const legacy = {
			paper: 'studio',
			mist: 'studio',
			olive: 'orchard',
			mono: 'carbon',
			cyber: 'studio',
			ink: 'studio',
			ocean: 'studio',
			navy: 'studio',
			forest: 'orchard',
			slate: 'studio',
			cinnabar: 'studio',
			amber: 'studio',
			'noir-red': 'carbon',
		};

		const toggle = document.getElementById('skin-toggle');
		const panel = document.getElementById('skin-panel');
		const toggleDot = document.getElementById('skin-toggle-dot');
		const toggleMode = document.getElementById('skin-toggle-mode');

		function setOpen(open) {
			if (!toggle || !panel) return;
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.hidden = !open;
		}

		function syncUi(mode, skin) {
			document.querySelectorAll('.mode-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-mode') === mode);
			});
			document.querySelectorAll('.skin-chip').forEach((btn) => {
				btn.classList.toggle('is-active', btn.getAttribute('data-skin') === skin);
			});
			if (toggleDot) toggleDot.style.background = swatches[skin] || swatches.studio;
			if (toggleMode) toggleMode.textContent = mode === 'dark' ? '☾' : '☀';
		}

		function notifyAppearance(mode, skin) {
			try {
				window.dispatchEvent(
					new CustomEvent('blog:appearance', {
						detail: { mode, skin },
					}),
				);
			} catch (_) {}
			if (typeof window.__blogSyncGiscus === 'function') {
				window.__blogSyncGiscus(mode);
			} else {
				const frame = document.querySelector('iframe.giscus-frame');
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage(
						{
							giscus: {
								setConfig: {
									theme: mode === 'dark' ? 'noborder_dark' : 'noborder_light',
								},
							},
						},
						'https://giscus.app',
					);
				}
			}
		}

		function applyMode(mode) {
			const next = mode === 'dark' ? 'dark' : 'light';
			root.classList.toggle('dark', next === 'dark');
			try {
				localStorage.setItem(MODE_KEY, next);
			} catch (_) {}
			const skin = root.getAttribute('data-skin') || 'studio';
			syncUi(next, skin);
			notifyAppearance(next, skin);
		}

		function applySkin(skin) {
			let next = legacy[skin] || skin;
			if (validSkins.indexOf(next) === -1) next = 'studio';
			root.setAttribute('data-skin', next);
			try {
				localStorage.setItem(SKIN_KEY, next);
			} catch (_) {}
			const mode = root.classList.contains('dark') ? 'dark' : 'light';
			syncUi(mode, next);
			notifyAppearance(mode, next);
		}

		function boot() {
			let mode = 'light';
			let skin = 'studio';
			try {
				mode = localStorage.getItem(MODE_KEY) || 'light';
				skin = localStorage.getItem(SKIN_KEY) || 'studio';
			} catch (_) {}
			applyMode(mode);
			applySkin(skin);
			setOpen(false);
		}

		boot();

		toggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		document.addEventListener('click', (e) => {
			const t = e.target;
			if (!(t instanceof Element)) return;
			if (t.closest('.skin-wrap')) {
				const modeBtn = t.closest('.mode-chip');
				if (modeBtn) {
					applyMode(modeBtn.getAttribute('data-mode') || 'light');
					return;
				}
				const skinBtn = t.closest('.skin-chip');
				if (skinBtn) {
					applySkin(skinBtn.getAttribute('data-skin') || 'studio');
					setOpen(false);
				}
				return;
			}
			setOpen(false);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	})();
</script>
