# —— 本地后台（默认）——
# npm run admin → http://127.0.0.1:4321/keystatic （脚本会强制 local）
PUBLIC_KEYSTATIC_STORAGE=local

# —— Vercel 线上后台（GitHub 登录发文）——
# 只在 Vercel Environment Variables 配置，不要写进本地 .env：
# KEYSTATIC_ADMIN=1
# PUBLIC_KEYSTATIC_STORAGE=github
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
